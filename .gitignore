# ============================================================
#  YT-Z (Rust / Tauri) — .gitignore
# ============================================================

# Rust / Cargo
/src-tauri/target/
**/*.rs.bk
Cargo.lock

# Node / Vite
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Tauri generated
/src-tauri/gen/
/src-tauri/.tauri/

# Android build outputs
/src-tauri/gen/android/
*.apk
*.aab

# App data (~/.ytz/)
*.db
*.db-shm
*.db-wal
downloads/
cache/

# OS files
Thumbs.db
desktop.ini
.DS_Store

# IDEs
.vscode/
.idea/
*.swp
