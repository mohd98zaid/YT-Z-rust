target/
**/*.rs.bk
*.pdb

# ------ Node.js / Vite / Frontend ----------------------------
node_modules/
dist/
dist-ssr/
.vite/
*.local
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# ------ Tauri Generated & Build Artifacts --------------------
/src-tauri/gen/
/src-tauri/.tauri/
*.exe
*.msi
*.deb
*.rpm
*.AppImage
*.dmg

# ------ Android Mobile Target Artifacts ----------------------
/src-tauri/gen/android/
*.apk
*.aab
*.apks
.gradle/
build/
captures/

# ------ App Data & SQLite (~/.ytz/) --------------------------
*.db
*.db-shm
*.db-wal
downloads/
cache/
.cache/

# ------ Environment & Secrets --------------------------------
.env
.env.local
.env.*
*.pem
*.key
*.pfx
secrets.json

# ------ OS & File Explorers ----------------------------------
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
._*

# ------ IDEs & Editors ---------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.suo

# ------ Logs & Temp ------------------------------------------
*.log
logs/
