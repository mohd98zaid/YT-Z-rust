{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YT-Z",
  "version": "2.0.0",
  "identifier": "com.mohdzaid.ytz",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "YT-Z - Ultimate YouTube Music & Downloader",
        "width": 960,
        "height": 620,
        "minWidth": 760,
        "minHeight": 500,
        "center": true,
        "decorations": true,
        "useHttpsScheme": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
